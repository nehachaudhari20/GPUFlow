DEBUG=True
MONGO_URI=
MONGO_DATABASE=gpuflow

# Worker / Scheduler settings
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15
SIMULATE_GPUS=True
SIMULATED_GPU_COUNT=1.0
SIMULATED_GPU_MEMORY_GB=16.0
GRPC_PORT=50051
SCHEDULER_ADDRESS=localhost:50051

# Scheduler scoring weights (must sum to 1.0)
SCHEDULE_GPU_WEIGHT=0.40
SCHEDULE_CPU_WEIGHT=0.25
SCHEDULE_RAM_WEIGHT=0.15
SCHEDULE_HEALTH_WEIGHT=0.10
SCHEDULE_LOAD_BALANCE_WEIGHT=0.10

# AWS control plane (see docker-compose.control.yml)
CPU_ONLY_MODE=False
WORKER_GRPC_PORT=0
