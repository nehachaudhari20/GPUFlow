# Control plane EC2 (scheduler + UI + MongoDB) — or use your laptop with public IP.

MONGO_URI=mongodb://mongodb:27017/gpuflow
GRPC_PORT=50051

# CPU-only AWS workers (no GPU quota)
CPU_ONLY_MODE=True
SCHEDULE_GPU_WEIGHT=0.0
SCHEDULE_CPU_WEIGHT=0.45
SCHEDULE_RAM_WEIGHT=0.25
SCHEDULE_HEALTH_WEIGHT=0.10
SCHEDULE_LOAD_BALANCE_WEIGHT=0.20
