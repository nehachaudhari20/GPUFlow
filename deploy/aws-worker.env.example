# Copy to /opt/gpuflow/worker.env on each EC2 worker and fill in values.
# gpuflow-1 (t2.large), gpuflow-2 (t2.xlarge), gpuflow-3 (t2.2xlarge)

SIMULATE_GPUS=False
CPU_ONLY_MODE=True

# Control plane private IP (scheduler + gRPC)
SCHEDULER_ADDRESS=10.0.1.10:50051

# THIS instance private IP (must match what scheduler uses to call back)
WORKER_HOSTNAME=10.0.1.21

# Fixed port — open in worker security group from control node SG
WORKER_GRPC_PORT=50052

# Optional display name in logs
WORKER_NAME=gpuflow-1
